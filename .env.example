# ==============================================================================
# Portainer & Docker Environment Variables Template
# ==============================================================================
# Copy this file to .env or paste these key-value pairs directly into the
# "Environment variables" section in the Portainer Stack Web Editor.
# Do NOT commit your real .env file to GitHub!
# ==============================================================================

# --- PostgreSQL Database Passwords ---
# Strong passwords for database admin, API gateway user, and Scraper worker user
DB_PASSWORD=replace_with_strong_postgres_admin_password
API_DB_PASSWORD=replace_with_strong_api_user_password
SCRAPER_DB_PASSWORD=replace_with_strong_scraper_user_password

# --- Telegram Bot & Notifications ---
# Note: Telegram Bot Token and Chat ID are configured directly in the App Settings UI (/settings)
# with full dynamic control, live testing, anomaly alerts, and TMA integration.

# --- Application Security ---
# Secret key used for signing JWT tokens in API Gateway
JWT_SECRET=replace_with_random_64_char_secret_string

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
NODE_ENV=production

# --- Google Gemini AI (Optional, can also be configured in /settings) ---
GEMINI_API_KEY=

# --- Host Port Mapping (Dedicated FinTrack Ports: 4747 Web, 4748 TMA, 4749 HTTPS, 4750 HTTP) ---
HOST_HTTPS_PORT=4749
HOST_HTTP_PORT=4750
